import java.util.LinkedList;
public class LinkedListAdd {
    public static void main(String[] args) {
        LinkedList<Integer> numbers = new LinkedList<>();
        numbers.add(10);
        numbers.add(20);
        numbers.add(30);
        numbers.add(40);
        System.out.println("LinkedList: " + numbers);
    }
}

OUTPUT:
LinkedList: [10, 20, 30, 40]
